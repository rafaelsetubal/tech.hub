# Resend API Key for sending emails from lead forms
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Tech Hub <orcamentos@techhubvision.com.br>

# Cloudflare Turnstile (Anti-spam Captcha)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...
# Use the site key and secret key from the SAME Turnstile widget.
# Allow both techhubvision.com.br and www.techhubvision.com.br in Cloudflare.
# In Vercel, set these variables for Production and redeploy after changes.
